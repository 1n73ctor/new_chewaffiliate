<section class="section">
  <div class="mw-640 center wrap">
    <h1 class="text-green"><%= locals.heading || title %></h1>
    <p class="lead"><%= locals.message || '' %></p>
    <div class="justify-center mt-150 row">
      <% (locals.actions || [{ href: '/', label: 'Go to homepage' }]).forEach(function (a) { %><a class="btn btn-green" href="<%= a.href %>"><%= a.label %></a><% }) %>
      <a class="btn btn-light" href="/help">Get help</a>
    </div>
  </div>
</section>
