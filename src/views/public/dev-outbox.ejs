<section class="pt-32 section">
  <div class="wrap">
    <h1>Development outbox</h1>
    <p class="muted">Emails and texts sent by the console driver (no SMTP / Twilio configured). This page does not exist in production.</p>
    <div class="table-wrap"><table class="table">
      <thead><tr><th>When</th><th>Channel</th><th>To</th><th>Subject / body</th></tr></thead>
      <tbody>
        <% if (!messages.length) { %><tr><td colspan="4" class="table-empty">Nothing sent yet.</td></tr><% } %>
        <% messages.forEach(function (m) { %>
        <tr><td class="nowrap"><%= u.timeAgo(m.created_at) %></td><td><%= m.channel %></td><td><%= m.recipient %></td><td><strong><%= m.subject || '' %></strong><pre class="pre-msg"><%= m.body %></pre></td></tr>
        <% }) %>
      </tbody>
    </table></div>
  </div>
</section>
