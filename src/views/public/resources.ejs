<section class="page-hero">
  <div class="wrap">
    <p class="eyebrow">Resources</p>
    <h1>Program documents &amp; guides</h1>
    <p>Everything you need to understand the Chew Network Affiliate Program before and after you join.</p>
  </div>
</section>
<section class="section" style="padding-top:32px">
  <div class="wrap" style="max-width:860px">
    <% const groups = {}; resources.forEach(function (r) { (groups[r.category || 'General'] = groups[r.category || 'General'] || []).push(r); }); %>
    <% Object.keys(groups).forEach(function (g) { %>
    <h2 style="font-size:1.1rem;text-transform:uppercase;letter-spacing:.08em;color:var(--muted);margin-top:1.5rem"><%= g %></h2>
    <div class="res-list">
      <% groups[g].forEach(function (r) { %>
      <a class="res-item" href="<%= r.url %>"><span class="ri"><%- icon('book') %></span><div><strong><%= r.title %></strong><span class="sub"><%= r.description %></span></div><span class="go"><%- icon('arrow') %></span></a>
      <% }) %>
    </div>
    <% }) %>
    <div class="panel-green mt-2">
      <strong>Affiliates:</strong> training lessons, the Content Kitchen and your sharing toolkit are inside your <a href="/office/resources">back office</a>.
    </div>
  </div>
</section>
