<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title><%= title ? `${title} · ${site.site_name}` : `${site.site_name} Affiliate Program — Free to Join` %></title>
<meta name="description" content="<%= description || 'Join the Chew Network Affiliate Program free. No purchase required. Get your Affiliate ID, the Content Kitchen, training and real tracking.' %>">
