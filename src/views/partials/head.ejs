<meta name="csrf-token" content="<%= csrfToken %>">
<meta property="og:site_name" content="<%= site.site_name %>">
<meta property="og:title" content="<%= title || 'Turn the Trillion Dollar World of Food Into Opportunity.' %>">
<meta property="og:description" content="<%= description || 'Join the Chew Network Affiliate Program — 100% free, no purchase required.' %>">
<meta property="og:image" content="<%= baseUrl %>/img/food/veggie-bowl.webp">
