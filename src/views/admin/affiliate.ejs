<% const tone = (s) => s === 'active' ? 'badge-live' : s.startsWith('pending') ? 'badge-soon' : 'badge-red'; %>
<p class="fine"><a href="/admin/affiliates">← Affiliates</a></p>
<div class="row-between">
  <div>
    <h1><%= a.first_name %> <%= a.last_name %></h1>
    <p class="page-intro mb-0"><span class="mono"><strong><%= a.affiliate_id || 'No Affiliate ID yet' %></strong></span> · <span class="badge <%= tone(a.status) %>"><%= C.USER_STATUSES[a.status] %></span><% if (a.role !== 'affiliate') { %> · <span class="badge badge-partner"><%= a.role %></span><% } %></p>
  </div>
</div>

<div class="items-start grid-2 mt-1">
  <div class="stack">
    <section class="card">
      <div class="card-head"><h2>Profile</h2></div>
      <dl class="dl">
        <dt>Email</dt><dd><%= a.email %> <%= a.email_verified_at ? '✓ verified' : '— not verified' %></dd>
        <dt>Mobile</dt><dd><%= a.mobile || '—' %> <%= a.phone_verified_at ? '✓ verified' : '' %></dd>
        <dt>Country</dt><dd><%= a.country || '—' %></dd>
        <dt>Signed up</dt><dd><%= u.fmtDateTime(a.created_at) %></dd>
        <dt>Heard via</dt><dd><%= a.signup_source || '—' %></dd>
        <dt>Sponsor</dt><dd><% if (sponsor) { %><a href="/admin/affiliates/<%= sponsor.id %>"><%= sponsor.first_name %> <%= sponsor.last_name %></a> (<span class="mono"><%= sponsor.affiliate_id %></span>)<% } else { %>—<% } %></dd>
        <dt>Agreement</dt><dd><%= a.agreement_version ? 'v' + a.agreement_version + ' · ' + u.fmtDateTime(a.agreement_accepted_at) : 'Not accepted' %></dd>
        <dt>Terms</dt><dd><%= u.fmtDateTime(a.terms_accepted_at) %></dd>
        <dt>Marketing email</dt><dd><%= a.marketing_consent ? 'Opted in' : 'No' %><%= a.marketing_consent_at ? ' · ' + u.fmtDate(a.marketing_consent_at) : '' %></dd>
        <dt>SMS</dt><dd><%= a.sms_consent ? 'Opted in' : 'No' %><%= a.sms_consent_at ? ' · ' + u.fmtDate(a.sms_consent_at) : '' %></dd>
        <dt>See It. Cook It.</dt><dd><%= a.app_activated_at ? 'Activated ' + u.fmtDate(a.app_activated_at) : a.app_linked_at ? 'Linked ' + u.fmtDate(a.app_linked_at) : 'Not linked' %></dd>
        <dt>Training</dt><dd><%= training %> lessons completed</dd>
        <dt>Last sign-in</dt><dd><%= a.last_login_at ? u.fmtDateTime(a.last_login_at) : '—' %></dd>
      </dl>
    </section>

    <section class="card">
      <div class="card-head"><h2>Last 30 days</h2><% if (can('tracking.view') && a.affiliate_id) { %><a class="fine" href="/admin/tracking?affiliate=<%= a.affiliate_id %>">Full tracking →</a><% } %></div>
      <div class="stats">
        <div class="stat"><span class="label">Clicks</span><span class="value"><%= summary.clicks %></span></div>
        <div class="stat"><span class="label">Referrals</span><span class="value"><%= summary.signups %></span><span class="meta"><%= summary.referralsAll %> all time</span></div>
        <div class="stat"><span class="label">Qualifying</span><span class="value"><%= summary.qualifying %></span></div>
        <div class="stat"><span class="label">Pending</span><span class="value"><%= u.money(summary.commissions.pending) %></span></div>
      </div>
    </section>

    <section class="card">
      <div class="card-head"><h2>Recent activity</h2></div>
      <% if (!events.length) { %><p class="muted mb-0">No events yet.</p><% } else { %>
      <div class="table-wrap"><table class="table"><thead><tr><th>When</th><th>Event</th><th>Role</th></tr></thead><tbody>
        <% events.forEach(function (e) { %><tr><td class="nowrap"><%= u.timeAgo(e.created_at) %></td><td><%= eventTypes[e.type] || e.type %></td><td><%= e.affiliate_user_id === a.id ? 'Credited to them' : 'Their own action' %></td></tr><% }) %>
      </tbody></table></div><% } %>
    </section>

    <section class="card">
      <div class="card-head"><h2>Tracked links</h2></div>
      <% if (!links.length) { %><p class="muted mb-0">No tracked links yet.</p><% } else { %>
      <div class="table-wrap"><table class="table"><thead><tr><th>Link</th><th>Destination</th><th class="num">Clicks</th></tr></thead><tbody>
        <% links.forEach(function (l) { %><tr class="<%= l.active ? '' : 'is-dim' %>"><td><%= l.label || l.code %><br><span class="mono fine"><%= l.code %></span></td><td><%= l.destination_key %></td><td class="num"><%= l.clicks %></td></tr><% }) %>
      </tbody></table></div><% } %>
    </section>

    <% if (commissions) { %>
    <section class="card">
      <div class="card-head"><h2>Commissions</h2><a class="fine" href="/admin/commissions?affiliate=<%= a.affiliate_id || '' %>">Ledger →</a></div>
      <% if (!commissions.length) { %><p class="muted mb-0">No entries.</p><% } else { %>
      <div class="table-wrap"><table class="table"><tbody>
        <% commissions.forEach(function (c) { %><tr><td><%= u.fmtDate(c.created_at) %></td><td><%= c.description %></td><td><%= C.COMMISSION_STATUSES[c.status] %></td><td class="num"><%= u.money(c.amount_cents, c.currency) %></td></tr><% }) %>
      </tbody></table></div><% } %>
    </section>
    <% } %>
  </div>

  <div class="stack">
    <% if (can('affiliates.support')) { %>
    <section class="card">
      <div class="card-head"><h2>Support actions</h2></div>
      <div class="stack">
        <% if (a.status === 'pending_verification') { %>
          <p class="fs-90 mb-0 muted">This person hasn’t entered their verification code yet.</p>
          <div class="row">
            <form class="inline-form" method="post" action="/admin/affiliates/<%= a.id %>/resend-code"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="channel" value="email"><button class="btn btn-light btn-sm" type="submit"><%- icon('mail') %> Resend code by email</button></form>
            <% if (a.mobile) { %><form class="inline-form" method="post" action="/admin/affiliates/<%= a.id %>/resend-code"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="channel" value="sms"><button class="btn btn-light btn-sm" type="submit"><%- icon('phone') %> Resend by text</button></form><% } %>
          </div>
          <form class="form" method="post" action="/admin/affiliates/<%= a.id %>/verify" data-confirm="Mark this email as verified? Only do this after confirming the person’s identity.">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="field"><label for="v-reason">Manual verification note</label><input id="v-reason" type="text" name="reason" placeholder="e.g. Confirmed by phone call"></div>
            <div><button class="btn btn-light btn-sm" type="submit"><%- icon('shield') %> Mark email verified</button></div>
          </form>
        <% } %>
        <% if (a.status === 'pending_agreement') { %><p class="fs-90 mb-0 muted">Verified — waiting for them to accept the Affiliate Agreement (they’ll see it at next sign-in).</p><% } %>
        <form method="post" action="/admin/affiliates/<%= a.id %>/reset"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-light btn-sm" type="submit"><%- icon('key') %> Email a password reset link</button></form>
      </div>
    </section>
    <% } %>

    <% if (can('affiliates.status') && a.role === 'affiliate') { %>
    <section class="card">
      <div class="card-head"><h2>Account status</h2></div>
      <form class="form" method="post" action="/admin/affiliates/<%= a.id %>/status">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="field"><label for="st">Status</label><select id="st" name="status">
          <option value="active" <%= a.status === 'active' ? 'selected' : '' %>>Active</option>
          <option value="suspended" <%= a.status === 'suspended' ? 'selected' : '' %>>Suspended</option>
          <% if (can('affiliates.manage')) { %><option value="closed" <%= a.status === 'closed' ? 'selected' : '' %>>Closed</option><% } %>
        </select></div>
        <div class="field"><label for="reason">Reason (saved as a note)</label><input id="reason" type="text" name="reason"></div>
        <div><button class="btn btn-green btn-sm" type="submit">Update status</button></div>
      </form>
    </section>
    <% } %>

    <section class="card">
      <div class="card-head"><h2>Messages sent</h2></div>
      <% if (!messages.length) { %><p class="muted mb-0">None.</p><% } %>
      <ul class="timeline"><% messages.forEach(function (m) { %><li><strong><%= m.subject || (m.channel === 'sms' ? 'Text message' : 'Email') %></strong><div class="meta"><%= m.channel %> → <%= m.recipient %> · <%= u.timeAgo(m.created_at) %> · <%= m.status %><%= m.error ? ' (' + m.error + ')' : '' %></div></li><% }) %></ul>
    </section>

    <section class="card" id="notes">
      <div class="card-head"><h2>Internal notes</h2></div>
      <% if (can('affiliates.support')) { %>
      <form class="form" method="post" action="/admin/affiliates/<%= a.id %>/note"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="field"><label for="note" class="sr-only">Add a note</label><textarea class="minh-80" id="note" name="body" placeholder="Add a note visible to staff only"></textarea></div><div><button class="btn btn-light btn-sm" type="submit">Add note</button></div></form>
      <% } %>
      <ul class="timeline mt-1"><% notes.forEach(function (n) { %><li><div class="meta"><%= n.author || 'Staff' %> · <%= u.fmtDateTime(n.created_at) %></div><p><%= n.body %></p></li><% }) %></ul>
    </section>

    <section class="card">
      <div class="card-head"><h2>Referrals</h2></div>
      <% if (!referrals.length) { %><p class="muted mb-0">No referrals yet.</p><% } %>
      <% referrals.forEach(function (r) { %><p class="py-030 mb-0"><a href="/admin/affiliates/<%= r.id %>"><%= r.first_name %> <%= r.last_name %></a> <span class="mono fine"><%= r.affiliate_id || '' %></span> · <span class="fine"><%= C.USER_STATUSES[r.status] %></span></p><% }) %>
    </section>
  </div>
</div>
