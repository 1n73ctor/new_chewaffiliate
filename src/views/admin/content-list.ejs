<div class="row-between">
  <div><h1>Content Kitchen</h1><p class="page-intro mb-0">Approved media for affiliates. Published assets appear in every back office immediately.</p></div>
  <div class="row"><a class="btn btn-light" href="/admin/content/todays-3"><%- icon('flame') %> Today’s 3</a><a class="btn btn-green" href="/admin/content/new"><%- icon('plus') %> New asset</a></div>
</div>
<form class="toolbar" method="get">
  <div class="field"><label for="status">Status</label><select id="status" name="status" data-autosubmit><option value="">All</option><% Object.entries(statuses).forEach(function ([k, v]) { %><option value="<%= k %>" <%= status === k ? 'selected' : '' %>><%= v %></option><% }) %></select></div>
  <div class="field"><label for="category">Category</label><select id="category" name="category" data-autosubmit><option value="">All</option><% categories.forEach(function (c) { %><option value="<%= c.id %>" <%= category === c.id ? 'selected' : '' %>><%= c.name %></option><% }) %></select></div>
  <noscript><button class="btn btn-light" type="submit">Filter</button></noscript>
</form>
<div class="table-wrap">
  <table class="table">
    <thead><tr><th></th><th>Asset</th><th>Category</th><th>Status</th><th>Platforms</th><th class="num">Viewed by</th><th class="num">Used by</th><th class="num">Clicks</th><th></th></tr></thead>
    <tbody>
      <% if (!rows.length) { %><tr><td colspan="9" class="table-empty">No assets yet. <a href="/admin/content/new">Add the first one</a>.</td></tr><% } %>
      <% rows.forEach(function (a) { %>
      <tr>
        <td><img class="thumb" src="<%= a.thumb_path || '/img/logo-mark.svg' %>" alt="" loading="lazy"></td>
        <td><a href="/admin/content/<%= a.id %>"><%= a.title %></a><% if (a.t3) { %> <span class="badge badge-soon">🔥 Today’s 3 · #<%= a.t3 %></span><% } %><br><span class="fine"><%= a.media_type %> · → <%= a.destination_key %></span></td>
        <td><%= a.category_name || '—' %></td>
        <td><span class="badge <%= a.status === 'published' ? 'badge-live' : a.status === 'draft' ? 'badge-grey' : 'badge-red' %>"><%= statuses[a.status] %></span></td>
        <td class="fine"><%= (a.platforms || '').split(',').filter(Boolean).join(', ') || '—' %></td>
        <td class="num"><%= a.previews %></td><td class="num"><%= a.users_used %></td><td class="num"><%= a.clicks %></td>
        <td class="actions"><a class="btn btn-light btn-xs" href="/admin/content/<%= a.id %>">Edit</a></td>
      </tr>
      <% }) %>
    </tbody>
  </table>
</div>
