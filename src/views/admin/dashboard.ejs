<h1>Overview</h1>
<p class="page-intro">Hi <%= user.first_name %>. Here’s the program at a glance.</p>
<div class="stats">
  <div class="stat"><span class="label">Active affiliates</span><span class="value"><%= u.num(counts.active) %></span><span class="meta"><%= u.num(counts.joined7) %> joined in 7 days</span></div>
  <div class="stat"><span class="label">Unfinished sign-ups</span><span class="value"><%= u.num(counts.pending) %></span><span class="meta">verification or agreement</span></div>
  <div class="stat"><span class="label">App activations</span><span class="value"><%= u.num(counts.activated) %></span><span class="meta">See It. Cook It.</span></div>
  <div class="stat"><span class="label">Open tickets</span><span class="value"><%= u.num(counts.tickets) %></span><span class="meta"><a href="/admin/tickets">Support queue</a></span></div>
</div>
<div class="stats mt-1">
  <div class="stat"><span class="label">Clicks · 7 days</span><span class="value"><%= u.num(summary.clicks) %></span><span class="meta"><%= u.num(summary.uniqueVisitors) %> unique</span></div>
  <div class="stat"><span class="label">Qualifying · 7 days</span><span class="value"><%= u.num(summary.qualifying) %></span><span class="meta">attributed results</span></div>
  <div class="stat"><span class="label">Published assets</span><span class="value"><%= u.num(counts.assets) %></span><span class="meta">Content Kitchen</span></div>
  <div class="stat"><span class="label">Pathways available</span><span class="value"><%= counts.available %> / <%= counts.pathways %></span><span class="meta"><a href="/admin/m/pathways">Manage statuses</a></span></div>
</div>
<section class="card mt-1">
  <div class="card-head"><h2>Program clicks per day</h2><span class="fine">last 30 days · bots &amp; self-clicks excluded</span></div>
  <%- barChart(series, { unit: 'clicks', label: 'Program clicks per day', empty: 'No affiliate link clicks yet.' }) %>
</section>
<div class="grid-2 mt-1">
  <section class="card">
    <div class="card-head"><h2>Latest sign-ups</h2><% if (can('affiliates.view')) { %><a class="fine" href="/admin/affiliates">All affiliates →</a><% } %></div>
    <% if (!recentSignups.length) { %><p class="muted mb-0">No sign-ups yet.</p><% } %>
    <div class="table-wrap" style="border:0"><table class="table"><tbody>
      <% recentSignups.forEach(function (a) { %><tr><td><a href="/admin/affiliates/<%= a.id %>"><%= a.first_name %> <%= a.last_name %></a><br><span class="fine"><%= a.email %></span></td><td><span class="mono"><%= a.affiliate_id || '—' %></span></td><td><span class="badge <%= a.status === 'active' ? 'badge-live' : a.status.startsWith('pending') ? 'badge-soon' : 'badge-red' %>"><%= C.USER_STATUSES[a.status] %></span></td></tr><% }) %>
    </tbody></table></div>
  </section>
  <% if (can('tickets.view')) { %>
  <section class="card">
    <div class="card-head"><h2>Recent support tickets</h2><a class="fine" href="/admin/tickets">Queue →</a></div>
    <% if (!recentTickets.length) { %><p class="muted mb-0">No tickets.</p><% } %>
    <% recentTickets.forEach(function (t) { %><div class="announce"><strong><a href="/admin/tickets/<%= t.id %>">#<%= t.id %> <%= t.subject %></a></strong><p class="fine"><%= t.topic %> · <%= t.email %> · <%= u.timeAgo(t.created_at) %> · <%= C.TICKET_STATUSES[t.status] %></p></div><% }) %>
  </section>
  <% } %>
</div>
