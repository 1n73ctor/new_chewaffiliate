<h1>🔥 Today’s 3</h1>
<p class="page-intro">“Fresh Out of the Kitchen” — the three picks shown at the top of every affiliate’s Dashboard and Content Kitchen.<% if (lastSet) { %> Last set <%= u.timeAgo(lastSet.set_at) %><%= lastSet.first_name ? ' by ' + lastSet.first_name : '' %>.<% } %></p>
<% if (!assets.length) { %><div class="empty"><%- icon('kitchen') %><h3>No published assets</h3><p>Publish Content Kitchen assets first.</p><a class="btn btn-green" href="/admin/content/new">New asset</a></div><% } else { %>
<form class="card form" method="post" action="/admin/content/todays-3" style="max-width:720px">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <% [1, 2, 3].forEach(function (rank) { const cur = current[rank] && current[rank].asset_id; %>
  <div class="field"><label for="rank<%= rank %>">Pick #<%= rank %></label>
    <select id="rank<%= rank %>" name="rank<%= rank %>"><option value="">— Automatic (newest published) —</option><% assets.forEach(function (a) { %><option value="<%= a.id %>" <%= cur === a.id ? 'selected' : '' %>><%= a.title %><%= a.category_name ? ' · ' + a.category_name : '' %></option><% }) %></select></div>
  <% }) %>
  <div><button class="btn btn-green btn-lg" type="submit">Publish Today’s 3</button></div>
  <p class="fine mb-0">Empty picks fall back to the newest published assets, so Today’s 3 is never blank.</p>
</form>
<% } %>
