<% const e = (k) => errors[k] ? `<p class="error">${u.esc(errors[k])}</p>` : ''; %>
<h1>Staff &amp; roles</h1>
<p class="page-intro">Role-based access. Support (e.g. Vanessa) can help affiliates without developer or finance permissions.</p>
<div class="table-wrap"><table class="table">
  <thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Status</th><th>Last sign-in</th><th></th></tr></thead>
  <tbody>
    <% staff.forEach(function (s) { %>
    <tr>
      <td><strong><%= s.first_name %> <%= s.last_name %></strong><%= s.id === user.id ? ' (you)' : '' %><br><span class="badge <%= s.totp_enabled_at ? 'badge-live' : 'badge-soon' %>"><%= s.totp_enabled_at ? '2-step on' : '2-step off' %></span></td>
      <td><%= s.email %></td>
      <td colspan="2">
        <form class="gap-040 row" method="post" action="/admin/staff/<%= s.id %>">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <select class="status-select" name="role" aria-label="Role" <%= s.id === user.id ? 'disabled' : '' %>><% staffRoles.forEach(function (r) { %><option value="<%= r %>" <%= s.role === r ? 'selected' : '' %>><%= roles[r].label %></option><% }) %><% if (s.affiliate_id) { %><option value="affiliate">Affiliate only (remove staff access)</option><% } %></select>
          <select class="status-select" name="status" aria-label="Status" <%= s.id === user.id ? 'disabled' : '' %>><option value="active" <%= s.status === 'active' ? 'selected' : '' %>>Active</option><option value="suspended" <%= s.status !== 'active' ? 'selected' : '' %>>Suspended</option></select>
          <% if (s.id !== user.id) { %><button class="btn btn-light btn-xs" type="submit">Save</button><% } %>
        </form>
      </td>
      <td class="nowrap"><%= s.last_login_at ? u.timeAgo(s.last_login_at) : 'Never' %></td>
      <td></td>
    </tr>
    <% }) %>
  </tbody>
</table></div>

<div class="items-start grid-2 mt-2">
  <form class="card form" method="post" action="/admin/staff">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="card-head"><h2>Add a staff member</h2></div>
    <div class="form-row two">
      <div class="field <%= errors.first_name ? 'has-error' : '' %>"><label for="sf">First name</label><input id="sf" type="text" name="first_name" value="<%= form.first_name || '' %>"><%- e('first_name') %></div>
      <div class="field <%= errors.last_name ? 'has-error' : '' %>"><label for="sl">Last name</label><input id="sl" type="text" name="last_name" value="<%= form.last_name || '' %>"><%- e('last_name') %></div>
    </div>
    <div class="field <%= errors.email ? 'has-error' : '' %>"><label for="se">Email</label><input id="se" type="email" name="email" value="<%= form.email || '' %>"><p class="hint">If they’re already an affiliate, they keep their Affiliate ID and get the role added.</p><%- e('email') %></div>
    <div class="field <%= errors.role ? 'has-error' : '' %>"><label for="sr">Role</label><select id="sr" name="role"><% staffRoles.forEach(function (r) { %><option value="<%= r %>" <%= form.role === r ? 'selected' : '' %>><%= roles[r].label %></option><% }) %></select><%- e('role') %></div>
    <div><button class="btn btn-green" type="submit">Add &amp; email set-password link</button></div>
  </form>
  <section class="card">
    <div class="card-head"><h2>What each role can do</h2></div>
    <div class="scroll-520 table-wrap"><table class="table perm-table">
      <thead><tr><th>Permission</th><% staffRoles.forEach(function (r) { %><th><%= roles[r].label %></th><% }) %></tr></thead>
      <tbody><% Object.entries(permissions).forEach(function ([p, label]) { %><tr><td><%= label %></td><% staffRoles.forEach(function (r) { const ok = roles[r].perms.includes('*') || roles[r].perms.includes(p); %><td class="<%= ok ? 'perm-yes' : 'perm-no' %>"><%= ok ? '✓' : '·' %></td><% }) %></tr><% }) %></tbody>
    </table></div>
  </section>
</div>
