<% const err = (k) => errors[k] ? `<p class="error">${u.esc(errors[k])}</p>` : ''; %>
<h1>My account</h1>
<p class="page-intro"><%= me.email %> · <%= roleLabel %><% if (me.last_login_at) { %> · last sign-in <%= u.timeAgo(me.last_login_at) %><% } %></p>
<div class="grid-2" style="align-items:start;max-width:980px">
  <section class="card">
    <div class="card-head"><h2>Change password</h2></div>
    <form class="form" method="post" action="/admin/account/password">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field <%= errors.current_password ? 'has-error' : '' %>"><label for="current_password">Current password</label><input id="current_password" type="password" name="current_password" autocomplete="current-password" required><%- err('current_password') %></div>
      <div class="field <%= errors.new_password ? 'has-error' : '' %>"><label for="new_password">New password</label><div class="pw-wrap"><input id="new_password" type="password" name="new_password" autocomplete="new-password" minlength="8" required><button class="pw-toggle" type="button" aria-pressed="false">Show</button></div><p class="hint">At least 8 characters. Signing in with the new password signs out your other devices.</p><%- err('new_password') %></div>
      <div class="field <%= errors.confirm_password ? 'has-error' : '' %>"><label for="confirm_password">Confirm new password</label><input id="confirm_password" type="password" name="confirm_password" autocomplete="new-password" minlength="8" required><%- err('confirm_password') %></div>
      <div><button class="btn btn-green" type="submit">Update password</button></div>
    </form>
  </section>
  <section class="card">
    <div class="card-head"><h2>Your name</h2></div>
    <form class="form" method="post" action="/admin/account/profile">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="form-row two">
        <div class="field <%= errors.first_name ? 'has-error' : '' %>"><label for="first_name">First name</label><input id="first_name" type="text" name="first_name" value="<%= me.first_name %>" autocomplete="given-name"><%- err('first_name') %></div>
        <div class="field <%= errors.last_name ? 'has-error' : '' %>"><label for="last_name">Last name</label><input id="last_name" type="text" name="last_name" value="<%= me.last_name %>" autocomplete="family-name"><%- err('last_name') %></div>
      </div>
      <div><button class="btn btn-light" type="submit">Save name</button></div>
    </form>
    <p class="fine mt-1 mb-0">To change your email or role, ask an administrator (Admin → Staff &amp; roles).</p>
  </section>
</div>
