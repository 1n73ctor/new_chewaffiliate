<% const err = (k) => errors[k] ? `<p class="error">${u.esc(errors[k])}</p>` : ''; %>
<h1 class="page-title">Account</h1>
<p class="page-intro">Affiliate ID <span class="mono"><strong><%= me.affiliate_id %></strong></span> · Member since <%= u.fmtDate(me.agreement_accepted_at || me.created_at) %></p>
<div class="items-start grid-2">
  <div class="stack">
    <section class="card">
      <div class="card-head"><h2>Profile</h2></div>
      <form class="form" method="post" action="/office/account/profile">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="form-row two">
          <div class="field <%= errors.first_name ? 'has-error' : '' %>"><label for="first_name">First name</label><input id="first_name" type="text" name="first_name" value="<%= me.first_name %>" autocomplete="given-name"><%- err('first_name') %></div>
          <div class="field <%= errors.last_name ? 'has-error' : '' %>"><label for="last_name">Last name</label><input id="last_name" type="text" name="last_name" value="<%= me.last_name %>" autocomplete="family-name"><%- err('last_name') %></div>
        </div>
        <div class="field"><label>Email</label><input type="email" value="<%= me.email %>" disabled><p class="hint">To change your email, <a href="/help#contact">contact support</a>.</p></div>
        <div class="form-row two">
          <div class="field <%= errors.mobile ? 'has-error' : '' %>"><label for="mobile">Mobile</label><input id="mobile" type="tel" name="mobile" value="<%= me.mobile || '' %>" autocomplete="tel"><%- err('mobile') %></div>
          <div class="field"><label for="country">Country</label><select id="country" name="country"><% countries.forEach(function (c) { %><option value="<%= c.code %>" <%= me.country === c.code ? 'selected' : '' %>><%= c.name %></option><% }) %></select></div>
        </div>
        <div><button class="btn btn-green" type="submit">Save profile</button></div>
      </form>
    </section>
    <section class="card">
      <div class="card-head"><h2>Password</h2></div>
      <form class="form" method="post" action="/office/account/password">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="field <%= errors.current_password ? 'has-error' : '' %>"><label for="current_password">Current password</label><input id="current_password" type="password" name="current_password" autocomplete="current-password"><%- err('current_password') %></div>
        <div class="field <%= errors.new_password ? 'has-error' : '' %>"><label for="new_password">New password</label><div class="pw-wrap"><input id="new_password" type="password" name="new_password" autocomplete="new-password" minlength="8"><button class="pw-toggle" type="button">Show</button></div><%- err('new_password') %></div>
        <div><button class="btn btn-green" type="submit">Update password</button></div>
      </form>
    </section>
  </div>
  <div class="stack">
    <section class="card" id="preferences">
      <div class="card-head"><h2>Communication preferences</h2></div>
      <p class="fs-90 muted">Optional and separate from your account terms. Account and security messages are always sent.</p>
      <form class="form" method="post" action="/office/account/preferences">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label class="check-row"><input type="checkbox" name="marketing_consent" value="1" <%= me.marketing_consent ? 'checked' : '' %>><span><strong>Marketing emails</strong><br><span class="fine"><%= me.marketing_consent ? 'Opted in ' + u.fmtDate(me.marketing_consent_at) : (me.marketing_consent_at ? 'Opted out ' + u.fmtDate(me.marketing_consent_at) : 'Not opted in') %></span></span></label>
        <label class="check-row"><input type="checkbox" name="sms_consent" value="1" <%= me.sms_consent ? 'checked' : '' %>><span><strong>Text messages</strong><br><span class="fine"><%= me.sms_consent ? 'Opted in ' + u.fmtDate(me.sms_consent_at) : (me.sms_consent_at ? 'Opted out ' + u.fmtDate(me.sms_consent_at) : 'Not opted in') %></span></span></label>
        <div><button class="btn btn-green" type="submit">Save preferences</button></div>
      </form>
    </section>
    <section class="card">
      <div class="card-head"><h2>Your agreement</h2></div>
      <dl class="dl">
        <dt>Affiliate Agreement</dt><dd>Version <%= me.agreement_version || '—' %> · accepted <%= u.fmtDateTime(me.agreement_accepted_at) %></dd>
        <dt>Terms &amp; Privacy</dt><dd>Accepted <%= u.fmtDate(me.terms_accepted_at) %></dd>
        <dt>Email verified</dt><dd><%= me.email_verified_at ? u.fmtDate(me.email_verified_at) : '—' %></dd>
        <dt>Phone verified</dt><dd><%= me.phone_verified_at ? u.fmtDate(me.phone_verified_at) : 'Not verified' %></dd>
        <dt>Referred by</dt><dd><%= sponsor ? sponsor.first_name + ' ' + sponsor.last_name.charAt(0) + '. (' + sponsor.affiliate_id + ')' : '—' %></dd>
      </dl>
      <p class="fine mt-1 mb-0"><a href="/affiliate-agreement">Read the agreement</a> · Want to close your account? <a href="/help#contact">Contact support</a>.</p>
    </section>
  </div>
</div>

<% if (wsAccount) { const w = wsAccount; const ackOk = w.attribution_ack_at && w.attribution_ack_version === termsVersion; %>
<h2 class="fs-120 mt-2" id="wholesale">See It. Cook It. wholesale</h2>
<div class="items-start grid-2">
  <div class="stack">
    <section class="card">
      <div class="card-head"><h2>Wholesale account</h2><span class="badge <%= w.status === 'active' ? 'badge-live' : w.status === 'suspended' ? 'badge-red' : 'badge-soon' %>"><%= w.status === 'prospect' ? 'Setting up' : w.status %></span></div>
      <dl class="dl">
        <dt>Wholesale affiliate ID</dt><dd class="mono"><%= w.wholesale_id %> <span class="fine">(read-only)</span></dd>
        <dt>Attribution policy</dt><dd><% if (ackOk) { %>Acknowledged <%= u.fmtDate(w.attribution_ack_at) %> · version <%= w.attribution_ack_version %><% } else { %><a href="/office/see-it-cook-it#policy">Acknowledge version <%= termsVersion %> →</a><% } %></dd>
      </dl>
      <p class="fine mt-1 mb-0"><a href="/wholesale-terms">Wholesale Terms</a> · Questions or a dispute about a creator? <a href="/help#contact">Send a support request</a>.</p>
    </section>
    <section class="card" id="domains">
      <div class="card-head"><h2>Promotional domains</h2></div>
      <p class="fs-sm muted">Websites where you promote See It. Cook It. Verify each one with a DNS TXT record.</p>
      <% if (domains.length) { %>
      <ul class="domain-list">
        <% domains.forEach(function (d) { %>
        <li>
          <div class="row-between"><strong><%= d.domain %></strong><span class="badge <%= d.status === 'verified' ? 'badge-live' : 'badge-soon' %>"><%= d.status === 'verified' ? 'Verified' : 'Not verified' %></span></div>
          <% if (d.status !== 'verified') { %>
          <p class="fine mb-040">Add a TXT record to <strong><%= d.domain %></strong> with the value:</p>
          <div class="copy-field"><input id="txt-<%= d.id %>" type="text" value="chew-verify=<%= d.token %>" readonly aria-label="TXT record value"><button class="btn btn-light" type="button" data-copy data-copy-target="#txt-<%= d.id %>"><%- icon('copy') %></button></div>
          <% } %>
          <div class="row mt-050">
            <% if (d.status !== 'verified') { %><form class="inline-form" method="post" action="/office/account/domains/<%= d.id %>/verify"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-green btn-xs" type="submit">Verify</button></form><% } %>
            <form class="inline-form" method="post" action="/office/account/domains/<%= d.id %>/delete"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-ghost btn-xs" type="submit">Remove</button></form>
            <span class="fine"><%= d.checked_at ? 'Checked ' + u.timeAgo(d.checked_at) : '' %></span>
          </div>
        </li>
        <% }) %>
      </ul>
      <% } %>
      <form class="row mt-1" method="post" action="/office/account/domains"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input class="grow minw-150" type="text" name="domain" placeholder="mycookingsite.com" aria-label="Domain"><button class="btn btn-light" type="submit"><%- icon('plus') %> Add domain</button></form>
    </section>
  </div>
  <div class="stack">
    <section class="card">
      <div class="card-head"><h2>Notifications &amp; branded site</h2></div>
      <form class="form" method="post" action="/office/account/wholesale">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label class="check-row"><input type="checkbox" name="notify_low_balance" value="1" <%= w.notify_low_balance ? 'checked' : '' %>><span><strong>Low credit balance</strong><br><span class="fine">When your available credits drop below the alert level</span></span></label>
        <label class="check-row"><input type="checkbox" name="notify_claims" value="1" <%= w.notify_claims ? 'checked' : '' %>><span><strong>Claims redeemed</strong><br><span class="fine">When a creator redeems your free credits in the app</span></span></label>
        <label class="check-row"><input type="checkbox" name="notify_earnings" value="1" <%= w.notify_earnings ? 'checked' : '' %>><span><strong>New earnings</strong><br><span class="fine">When eligible earnings are recorded</span></span></label>
        <div class="field"><label for="site_request_url">Branded site URL (optional)</label><input id="site_request_url" type="url" name="site_request_url" value="<%= w.site_request_url || '' %>" placeholder="https://"><p class="hint">Request a branded giveaway site, or tell us about the one you have.</p></div>
        <div class="field"><label for="site_request_note">Branded site request (optional)</label><textarea id="site_request_note" name="site_request_note" rows="2" maxlength="1000"><%= w.site_request_note || '' %></textarea><% if (w.site_request_status) { %><p class="hint">Status: <%= w.site_request_status %> · <%= u.fmtDate(w.site_requested_at) %></p><% } %></div>
        <div><button class="btn btn-green" type="submit">Save wholesale settings</button></div>
      </form>
    </section>
    <section class="card">
      <div class="card-head"><h2>Account history</h2></div>
      <% if (!history.length) { %><p class="fine mb-0">No account changes recorded yet.</p><% } else { %>
      <ul class="plain-list fs-sm"><% history.forEach(function (h) { %><li><%= h.action.replace(/^wholesale\./, '').replace(/_/g, ' ') %> · <span class="fine"><%= u.fmtDateTime(h.created_at) %></span></li><% }) %></ul>
      <% } %>
    </section>
  </div>
</div>
<% } %>
