<% const s = summary; const money = (c) => u.money(c); %>
<div class="row-between" style="margin-bottom:1rem">
  <div>
    <h1 class="page-title">Hi, <%= user.first_name %> 👋</h1>
    <p class="page-intro mb-0">Here’s your Chew back office.<% if (sponsor) { %> Referred by <%= sponsor.first_name %> <%= sponsor.last_name.charAt(0) %>. (<span class="mono"><%= sponsor.affiliate_id %></span>)<% } %></p>
  </div>
  <a class="btn btn-cta" href="/office/content-kitchen"><%- icon('flame') %> Share Today’s 3</a>
</div>

<div class="card id-card">
  <div class="id-card-inner">
    <div>
      <div class="label-sm">Your Affiliate ID</div>
      <div class="big-id"><%= user.affiliate_id %></div>
      <div class="label-sm" style="margin-bottom:.4rem">Primary referral link</div>
      <div class="copy-field"><input id="primary-link" type="text" value="<%= primaryLink %>" readonly data-select aria-label="Your primary referral link"><button class="btn btn-light" type="button" data-copy data-copy-target="#primary-link"><%- icon('copy') %> Copy</button></div>
      <div class="row" style="margin-top:.75rem">
        <button class="btn btn-sm btn-light" type="button" data-share="<%= primaryLink %>" data-share-title="Join me on Chew Network"><%- icon('share') %> Share</button>
        <a class="btn btn-sm btn-ghost" style="color:#fff" href="/office/links"><%- icon('link') %> More links</a>
      </div>
    </div>
    <div style="text-align:center">
      <div class="qr-box"><%- qrSvg %></div>
      <a class="btn btn-sm btn-ghost" style="color:#fff;margin-top:.4rem" href="/office/qr/primary.png?download=1"><%- icon('download') %> QR code</a>
    </div>
  </div>
</div>

<h2 class="mt-2" style="font-size:1.1rem">Last 30 days <span class="fine" style="font-weight:500">· real tracked activity only</span></h2>
<div class="stats">
  <div class="stat"><span class="label">Clicks</span><span class="value"><%= u.num(s.clicks) %></span><span class="meta"><%= u.num(s.uniqueVisitors) %> unique visitors</span></div>
  <div class="stat"><span class="label">Referrals</span><span class="value"><%= u.num(s.signups) %></span><span class="meta"><%= u.num(s.referralsAll) %> all time</span></div>
  <div class="stat"><span class="label">Qualifying activity</span><span class="value"><%= u.num(s.qualifying) %></span><span class="meta">sign-ups, activations &amp; actions</span></div>
  <div class="stat"><span class="label">Commissions</span><span class="value"><%= money(s.commissions.approved + s.commissions.paid) %></span><span class="meta"><%= money(s.commissions.pending) %> pending review</span></div>
</div>
<% if (!s.clicks && !s.signups && !s.qualifying) { %>
  <p class="fine mt-1">No activity yet — that’s normal for a new account. Share Today’s 3 or your link and your numbers will appear here as they happen.</p>
<% } %>

<section class="t3-banner mt-2" style="margin-bottom:0">
      <h2><%- icon('flame') %> TODAY’S 3 — Fresh Out of the Kitchen</h2>
      <p>Approved, ready-to-post picks. Copy the caption, get your link, post.</p>
      <% if (todays3.length) { %>
      <div class="t3-grid"><% todays3.forEach(function (a, i) { %><%- include('../partials/asset-card', { a: a, rank: i + 1 }) %><% }) %></div>
      <% } else { %><div class="empty"><%- icon('kitchen') %><h3>The kitchen is prepping</h3><p>New content is on its way.</p></div><% } %>
    </section>

<div class="dash-grid mt-2">
  <div class="stack">

    <section class="card">
      <div class="card-head"><h2>Announcements</h2></div>
      <% if (!announcements.length) { %><p class="muted mb-0">No announcements right now.</p><% } %>
      <% announcements.forEach(function (a) { %>
      <div class="announce">
        <strong><% if (a.pinned) { %><%- icon('bell') %><% } %><%= a.title %></strong>
        <% if (a.body) { %><p><%= a.body %></p><% } %>
        <% if (a.link_url) { %><a href="<%= a.link_url %>" style="font-weight:600;font-size:.9rem"><%= a.link_label || 'Learn more' %> →</a><% } %>
        <span class="fine"><%= u.fmtDate(a.created_at) %></span>
      </div>
      <% }) %>
    </section>
  </div>

  <div class="stack">
    <section class="card">
      <div class="card-head"><h2>See It. Cook It.</h2><span class="badge <%= activation.activated ? 'badge-live' : 'badge-soon' %>"><%= activation.activated ? 'Activated' : activation.completed + ' of ' + activation.total %></span></div>
      <ol class="activation-steps">
        <% activation.steps.forEach(function (st, i) { %>
        <li class="<%= st.done ? 'done' : '' %>"><span class="dot"><%- st.done ? icon('check') : i + 1 %></span><div><strong><%= st.label %></strong><span class="sub"><%= st.done ? 'Done ' + u.fmtDate(st.at) : st.detail %></span></div></li>
        <% }) %>
      </ol>
      <% if (!activation.activated) { %><a class="btn btn-green btn-block mt-1" href="/office/see-it-cook-it">Continue activation</a><% } %>
    </section>

    <section class="card">
      <div class="card-head"><h2>Training</h2><span class="fine"><%= training.done %> of <%= training.total %> lessons</span></div>
      <div class="progress" role="progressbar" aria-valuenow="<%= training.pct %>" aria-valuemin="0" aria-valuemax="100" aria-label="Training progress"><i style="width:<%= training.pct %>%"></i></div>
      <% if (training.next) { %>
        <p class="mt-1" style="margin-bottom:.6rem"><span class="fine">Up next · <%= training.next.module_title %></span><br><strong><%= training.next.title %></strong></p>
        <a class="btn btn-light btn-block" href="/office/training/<%= training.next.id %>">Start lesson</a>
      <% } else if (training.total) { %>
        <p class="mt-1 mb-0">🎉 All lessons complete.</p>
      <% } %>
    </section>

    <section class="card">
      <div class="card-head"><h2>New Chew opportunities</h2></div>
      <p class="muted" style="font-size:.92rem">See every pathway across the ecosystem and what’s available now.</p>
      <a class="btn btn-light btn-block" href="/office/ways-to-earn">Explore Ways to Earn</a>
    </section>
  </div>
</div>
