<% const s = summary; %>
<div class="row-between">
  <div><h1 class="page-title">Analytics</h1><p class="page-intro mb-0">Real tracked activity only. Link-preview bots and your own clicks are excluded.</p></div>
  <nav class="p-0 pills" aria-label="Date range">
    <% ranges.forEach(function (d) { %><a class="pill <%= days === d ? 'on' : '' %>" href="?days=<%= d %>">Last <%= d %> days</a><% }) %>
  </nav>
</div>
<div class="stats mt-1">
  <div class="stat"><span class="label">Clicks</span><span class="value"><%= u.num(s.clicks) %></span><span class="meta"><%= u.num(s.uniqueVisitors) %> unique visitors</span></div>
  <div class="stat"><span class="label">Referred sign-ups</span><span class="value"><%= u.num(s.signups) %></span><span class="meta"><%= s.clicks ? ((s.signups / s.clicks) * 100).toFixed(1) + '% of clicks' : '—' %></span></div>
  <div class="stat"><span class="label">App activations</span><span class="value"><%= u.num(s.activations) %></span><span class="meta"><%= u.num(s.appDownloads) %> download clicks</span></div>
  <div class="stat"><span class="label">Qualifying activity</span><span class="value"><%= u.num(s.qualifying) %></span><span class="meta">all qualifying events</span></div>
</div>
<% if (ppcOn || s.paidClicks || s.unpaidClicks.length) { const unpaidTotal = s.unpaidClicks.reduce((n, r) => n + r[1], 0); %>
<section class="card mt-1">
  <div class="card-head"><h2>Paid clicks</h2><span class="fine">verified, unique visitors only</span></div>
  <div class="stats">
    <div class="stat"><span class="label">Paid clicks</span><span class="value"><%= u.num(s.paidClicks) %></span><span class="meta">last <%= days %> days</span></div>
    <div class="stat"><span class="label">Not paid</span><span class="value"><%= u.num(unpaidTotal) %></span><span class="meta">see reasons</span></div>
  </div>
  <% if (s.unpaidClicks.length) { %>
  <div class="funnel mt-1">
    <% s.unpaidClicks.forEach(function (r) { %><div class="funnel-row"><span><%= r[0] %></span><strong><%= u.num(r[1]) %></strong></div><% }) %>
  </div>
  <% } %>
  <p class="fine mt-1 mb-0">A click is paid once per visitor (IP address or device) in each <%= site.ppc_unique_hours %>-hour window, only from a real browser, never for your own clicks, and up to <%= u.num(Number(site.ppc_daily_cap)) %> paid clicks a day.</p>
</section>
<% } %>

<section class="card mt-1">
  <div class="card-head"><h2>Clicks per day</h2><span class="fine">last <%= days %> days</span></div>
  <%- barChart(series, { unit: 'clicks', label: 'Clicks per day', empty: 'No clicks in this period yet. Share your link or a Content Kitchen post to see activity here.' }) %>
</section>

<div class="grid-2 mt-1">
  <section class="card">
    <div class="card-head"><h2>From click to result</h2></div>
    <div class="funnel">
      <div class="funnel-row"><span>Link clicks</span><strong><%= u.num(s.clicks) %></strong></div>
      <div class="funnel-row"><span>Referred affiliates joined</span><strong><%= u.num(s.signups) %></strong></div>
      <div class="funnel-row"><span>App download clicks</span><strong><%= u.num(s.appDownloads) %></strong></div>
      <div class="funnel-row"><span>App accounts linked</span><strong><%= u.num(s.appLinked) %></strong></div>
      <div class="funnel-row"><span>App activations</span><strong><%= u.num(s.activations) %></strong></div>
      <div class="funnel-row"><span>Other qualifying actions &amp; purchases</span><strong><%= u.num((s.events.qualifying_action || 0) + (s.events.purchase || 0)) %></strong></div>
    </div>
  </section>
  <%- include('../partials/breakdown', { heading: 'By source / channel', rows: bySource }) %>
  <%- include('../partials/breakdown', { heading: 'By content', rows: byContent }) %>
  <%- include('../partials/breakdown', { heading: 'By link', rows: byLink }) %>
  <%- include('../partials/breakdown', { heading: 'By campaign', rows: byCampaign }) %>
  <%- include('../partials/breakdown', { heading: 'By destination / product', rows: byDestination }) %>
</div>

<section class="mt-2">
  <h2 class="fs-110">Recent results</h2>
  <div class="table-wrap"><table class="table">
    <thead><tr><th>When</th><th>Result</th><th>Content</th><th>Source</th><th>Destination</th></tr></thead>
    <tbody>
      <% if (!recent.length) { %><tr><td colspan="5" class="table-empty">No results yet.</td></tr><% } %>
      <% recent.forEach(function (e) { %>
      <tr><td class="nowrap"><%= u.timeAgo(e.created_at) %></td><td><%= eventTypes[e.type] || e.type %></td><td><%= e.content_title || '—' %></td><td><%= e.source || '—' %></td><td><%= e.destination_label || e.destination_key || '—' %></td></tr>
      <% }) %>
    </tbody>
  </table></div>
</section>

<% if (sicReport) { const r = sicReport; const f = sicFilters; const qs = new URLSearchParams(Object.entries(f).filter(function (e) { return e[1]; })).toString(); %>
<section class="mt-2" id="sic-users">
  <div class="row-between"><h2 class="fs-110 m-0"><%- icon('users') %> MY SEE IT. COOK IT. USERS</h2><a class="btn btn-light btn-sm" href="/office/analytics/sic-users.csv<%= qs ? '?' + qs : '' %>"><%- icon('download') %> Export CSV</a></div>
  <p class="fine">Only creators assigned to you. IDs are masked — creators’ names, emails and payment details are never shown.</p>
  <div class="stats stats-6">
    <div class="stat"><span class="label">Assigned creators</span><span class="value"><%= u.num(r.summary.total) %></span></div>
    <div class="stat"><span class="label">With credits</span><span class="value"><%= u.num(r.summary.with_credits) %></span><span class="meta">enough for a video</span></div>
    <div class="stat"><span class="label">Subscribers</span><span class="value"><%= u.num(r.summary.subscribers) %></span></div>
    <div class="stat"><span class="label">Credits used</span><span class="value"><%= u.num(r.summary.consumed) %></span></div>
    <div class="stat"><span class="label">Conversions</span><span class="value"><%= u.num(r.summary.conversions) %></span><span class="meta">paid subscription or download</span></div>
    <div class="stat"><span class="label">Attribution exceptions</span><span class="value"><%= u.num(r.summary.exceptions) %></span><span class="meta">claims released or reassigned</span></div>
  </div>
  <form class="sic-filters mt-1" method="get" action="/office/analytics#sic-users">
    <div class="field"><label for="f-from">Joined from</label><input id="f-from" type="date" name="from" value="<%= f.from %>"></div>
    <div class="field"><label for="f-to">to</label><input id="f-to" type="date" name="to" value="<%= f.to %>"></div>
    <div class="field"><label for="f-link">Campaign / link</label><select id="f-link" name="link"><option value="">All</option><% r.links.forEach(function (l) { %><option value="<%= l.id %>" <%= String(f.link) === String(l.id) ? 'selected' : '' %>><%= l.label %></option><% }) %></select></div>
    <div class="field"><label for="f-sub">Subscription</label><select id="f-sub" name="subscribed"><option value="">All</option><option value="yes" <%= f.subscribed === 'yes' ? 'selected' : '' %>>Subscribed</option><option value="no" <%= f.subscribed === 'no' ? 'selected' : '' %>>Not subscribed</option></select></div>
    <div class="field"><label for="f-act">Activity</label><select id="f-act" name="activity"><option value="">All</option><option value="active" <%= f.activity === 'active' ? 'selected' : '' %>>Active (30 days)</option><option value="inactive" <%= f.activity === 'inactive' ? 'selected' : '' %>>Inactive</option></select></div>
    <div class="sic-filter-actions"><button class="btn btn-green" type="submit">Filter</button><% if (qs) { %><a class="btn btn-ghost" href="/office/analytics#sic-users">Clear</a><% } %></div>
  </form>
  <div class="table-wrap mt-1"><table class="table">
    <thead><tr><th>Creator</th><th>Joined</th><th>Referral campaign</th><th class="num">Grants</th><th class="num">Credits used</th><th class="num">Remaining</th><th>Subscription</th><th>Last activity</th><th>Affiliate ID</th></tr></thead>
    <tbody>
      <% if (!r.rows.length) { %><tr><td colspan="9" class="table-empty"><%= qs ? 'No creators match these filters.' : 'No creators yet. Share a claim link — creators appear here once they redeem it in the app.' %></td></tr><% } %>
      <% r.rows.forEach(function (c) { %>
      <tr>
        <td class="mono nowrap"><%= c.ref %></td>
        <td class="nowrap"><%= u.fmtDate(c.assigned_at) %></td>
        <td><%= c.campaign_name || c.link_label || (c.source === 'app_referral' ? 'App referral' : '—') %></td>
        <td class="num"><%= u.num(c.grants) %> <span class="fine">(<%= u.num(c.granted) %>)</span></td>
        <td class="num"><%= u.num(c.used) %></td>
        <td class="num"><%= u.num(c.remaining) %></td>
        <td><span class="badge <%= ['active','trialing'].includes(c.subscription_status) ? 'badge-live' : 'badge-grey' %>"><%= c.subscription_status === 'none' ? 'Not subscribed' : c.subscription_status %></span></td>
        <td class="nowrap"><%= c.last_active_at ? u.timeAgo(c.last_active_at) : '—' %></td>
        <td class="mono"><%= c.affiliate_id %></td>
      </tr>
      <% }) %>
    </tbody>
  </table></div>
</section>
<% } %>
