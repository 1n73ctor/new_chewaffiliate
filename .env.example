# Copy to .env and fill in. Everything is optional in development.

# ---- Docker / VPS deployment (docker-compose.yml) ----
# Your domain (e.g. affiliates.chew.network), pointed at the server with a DNS
# A record. Caddy gets the HTTPS certificate for it automatically.
# In Docker, NODE_ENV=production, PORT and BASE_URL=https://$DOMAIN are set for you.
DOMAIN=

NODE_ENV=development
PORT=3000
# Public URL used in referral links, QR codes and emails (no trailing slash)
BASE_URL=http://localhost:3000

# Required in production (long random string). Dev generates one in data/.dev-secret
SESSION_SECRET=

# Storage (defaults: ./data/chew.db and ./data/uploads)
# DATA_DIR=./data
# DATABASE_PATH=./data/chew.db
# UPLOAD_DIR=./data/uploads

# First admin account, created on first start if no admin exists.
# Leave ADMIN_PASSWORD blank to generate one (saved to data/initial-admin.txt).
ADMIN_EMAIL=admin@chew.local
ADMIN_PASSWORD=

# Email (verification codes, password resets, support replies).
# Without SMTP_HOST, messages are logged to the console and /dev/outbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Chew Network <no-reply@chew.network>"

# SMS verification codes (Twilio). Without these, texts are logged instead.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Behind a load balancer / reverse proxy (production default: 1 hop)
# TRUST_PROXY=1
