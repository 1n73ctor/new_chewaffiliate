# Caddy gets and renews HTTPS certificates for DOMAIN and www.DOMAIN automatically.
# DOMAIN comes from .env (see docker-compose.yml). Both names need DNS records
# pointing at the server (www can be a CNAME to the bare domain).

{$DOMAIN} {
	encode zstd gzip
	header -Server
	reverse_proxy app:3000
}

# www → bare domain, keeping the path (so /a/<ID> referral links still work)
www.{$DOMAIN} {
	header -Server
	redir https://{$DOMAIN}{uri} permanent
}
